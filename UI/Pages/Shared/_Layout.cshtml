@{
    ViewData["Title"] = "TrendyClothes";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/Navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/Home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/Login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UI.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">TrendyClothes</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Inicio</a> <!--TODO-->
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Categorías</a> <!--TODO-->
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Ofertas</a> <!--TODO-->
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Moda</a> <!--TODO-->
                        </li>
                    </ul>
                </div>
                <div class="input-group search-box">
                    <!-- TODO -->
                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" class="form-control" placeholder="Buscar...">
                </div>
                <a class="nav-link text-dark me-3" asp-area="" asp-page="/Index">
                    <img src="~/images/shoppingCart.png" class="profile-img" alt="Perfil" />
                </a>
                <div class="dropdown">
                    <button class="btn btn-transparent dropdown-toggle " type="button">
                        <img src="~/images/noprofilephoto.png" class="profile-img bg-transparent" /> <!--TODO-->
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" asp-page="/User/ViewProfile">Ver perfil</a></li>
                        <li><a class="dropdown-item" asp-page="">Lista de deseos</a></li>
                        <li><a class="dropdown-item" asp-page="">Favoritos</a></li>
                        <li><a class="dropdown-item" asp-page="/User/Login">Iniciar sesión</a></li>
                        <li><a class="dropdown-item" asp-page="">Cerrar sesión</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted box-shadow bg-white">
        <div class="container">
            &copy; 2025 - TrendyClothes
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
