@page
@model UI_ASP.Pages.Products.EditProductModel
@{
}

<div class="container h-100">
    <div class="row h-100">
        <div class="col-4 d-block align-items-center justify-content-center">
            <img style="max-width: 100%" src="https://th.bing.com/th/id/OIP.WeSkkwLXkUXbRcLJuN7I_gHaHa?cb=iwp2&rs=1&pid=ImgDetMain" />
            <span class="text-danger"></span>
            <div class="container text-center mt-3">
                <button type="button" class="btn btn-primary p-1">Subir imagen</button>
                <button type="button" class="btn btn-danger p-1">Elminar imagen</button>
            </div>
        </div>
        <div class="col-8 text-start d-block align-content-top pe-5">
            <div class="align-content-start text-start" style="min-width: 25em; max-width:100%;">
                <label class="form-label mb-0 fw-bold">Nombre:</label>
                <input id="InputName" class="form-control my-1 mx-2" autocomplete="none" />
                <span class="text-danger m-0"></span>
            </div>
            <div class="row mt-2 text-center">
                <div class="col-6 text-start">
                    <div class="row">
                        <label class="form-label mb-0 fw-bold col align-content-center text-start">Precio:</label>
                        <input id="InputPrice" class="form-control my-1 mx-2 col p-1" style="width: 2em;" autocomplete="none" />
                    </div>
                    <span <class="text-danger m-0"></span>
                </div>
                <div class="col-6 text-end">
                    <div class="row">
                        <label class="form-label mb-0 fw-bold col align-content-center text-start">Descuento (%):</label>
                        <input id="InputDiscount" class="form-control my-1 mx-2 col p-1" style="width: 2em;" autocomplete="none" />
                    </div>
                    <span class="text-danger m-0"></span>
                </div>
            </div>
            <div class="row mt-2 text-center">
                <div class="col-6 text-start">
                    <div class="row">
                        <label class="form-label mb-0 fw-bold col align-content-center text-start">Stock disponible:</label>
                        <input id="InputStockAvailable" class="form-control my-1 mx-2 col p-1" style="width: 2em;" autocomplete="none" />
                    </div>
                    <span <class="text-danger m-0"></span>
                </div>
                <div class="col-6 text-end">
                    <div class="row">
                        <label class="form-label mb-0 fw-bold col-6 align-content-center text-start">Categoría:</label>
                        <select class="form-select" id="InputCategorie" class="form-control my-1 mx-2 col-6 p-1" style="min-width: 4em; max-width: 9em;" autocomplete="none">
                            <option disabled selected>Eliga</option>
                        </select>
                    </div>
                    <span class="text-danger m-0"></span>
                </div>
            </div>
            <div class="row mt-2 text-center">
                <div class="col-6 text-end">
                    <div class="row">
                        <label class="form-label mb-0 fw-bold col-6 align-content-center text-start">Status publicación:</label>
                        <select class="form-select" id="InputStatus" class="form-control my-1 mx-2 col-6 p-1" style="min-width: 4em; max-width: 9em;" autocomplete="none">
                            <option disabled selected>Eliga</option>
                            <option value="1">Activa</option>
                            <option value="2">Pausada</option>
                        </select>
                    </div>
                    <span class="text-danger m-0"></span>
                </div>
                <div class="col-6 text-end">
                    <div class="row">
                        <label class="form-label mb-0 fw-bold col-6 align-content-center text-start">Estado producto:</label>
                        <select class="form-select" id="InputType" class="form-control my-1 mx-2 col-6 p-1" style="min-width: 4em; max-width: 9em;" autocomplete="none">
                            <option disabled selected>Eliga</option>
                            <option value="1">Nuevo</option>
                            <option value="2">Usado</option>
                        </select>
                    </div>
                    <span class="text-danger m-0"></span>
                </div>
            </div>
            <div class="align-content-start text-start mt-3" style="min-width: 25em; max-width:100%;">
                <label class="form-label mb-0 fw-bold">Descripción:</label>
                <span class="text-danger m-0"></span>
                <textarea class="form-control" id="descripcion" rows="8" placeholder="Escribe aquí una descripción larga y detallada..."></textarea>
            </div>
        </div>
    </div>
</div>