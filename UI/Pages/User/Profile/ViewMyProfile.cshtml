@page
@model UI.Pages.User.Profile.ViewMyProfileModel
@{
    ViewData["Title"] = "Perfil de usuario";
}

<div class="container bg-white px-4 py-5">
    <h1 class="text-center mb-5">Perfil de usuario</h1>
    <div class="container text-center">
        <!-- Personal data -->
        <div class="row">
            <div class="col">
                <table class="table table-striped table-bordered">
                    <thead>
                    <th class="bg-primary text-white" colspan="2"><h3>Datos personales</h3></th>
                    </thead>
                    <tbody>
                        <tr>
                            <th>Correo electrónico:</th>
                            <td>@(Model.currentUser.email ?? "No disponible.")</td>
                        </tr>
                        <tr>
                            <th>Nombre de usuario:</th>
                            <td>@(Model.currentUser.username ?? "No disponible.")</td>
                        </tr>
                        <tr>
                            <th>Nombre completo:</th>
                            <td>@(Model.currentUser.fullName ?? "No disponible.")</td>
                        </tr>
                        <tr>
                            <th>Tipo de usuario:</th>
                            <td><span class="badge bg-info">@(Model.currentUser.role ?? "No disponible.")</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <!-- Addresses -->
        <div class="row">
            <div class="col">
                <table class="table table-striped table-bordered table-responsive">
                    <thead>
                    <th class="bg-primary text-white"><h3>Activa</h3></th>
                    <th class="bg-primary text-white"><h3>Dirección</h3></th>
                    </thead>
                    <tbody>
                        @if (Model.addresses == null || Model.addresses.Count <= 0){
                            <tr>
                                <td></td>
                                <td>El usuario no tiene direcciones registradas.</td>
                            </tr>
                        }
                        @foreach(var item in Model.addresses){
                            <tr>
                                <td>@item.isActive</td>
                                <td>
                                    @($"{item.numberExterior} {item.numberExterior} {item.street} {item.neighborhood} {item.postalCode} {item.state} {item.country}")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Botón para iniciar subasta -->
    <div class="text-center mt-5">
        <h2 class="mb-4">Subastar productos</h2>
        <button id="startAuction" class="btn btn-secondary btn-lg">Iniciar subasta</button>
    </div>
</div>

<script type="module" src="~/js/User/Profile/ViewMyProfile.js"></script>
