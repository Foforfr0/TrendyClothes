@page
@model UI.Pages.User.Auth.LoginModel
@{
    ViewData["Title"] = "Inicio de sesión";
}

<div class="container bg-white px-3 py-4">
    <h1 class="text-center mb-4">Ingresar a TrendyClothes</h1>
    <div class="row">

        <!-- Section Username and Password -->
        <div class="col-md-6 border-end">
            <fieldset id="firstFieldsetLogin" enabled>
                <form method="post" id="loginForm" novalidate>
                    <div class="mb-3">
                        <label asp-for="_loginDTO.username" class="form-label">Nombre de usuario:</label>
                        <input asp-for="_loginDTO.username" id="InputUsername" class="form-control" autocomplete="off" />
                        <span class="text-danger" asp-validation-for="_loginDTO.username"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="_loginDTO.password" class="form-label">Contraseña:</label>
                        <input asp-for="_loginDTO.password" id="InputPassword" class="form-control" type="password" autocomplete="off" />
                        <span class="text-danger" asp-validation-for="_loginDTO.password"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Ingresar</button>
                </form>
                <div class="mt-3">
                    <button type="button" class="btn btn-link">¿Olvidó su usuario?</button>
                    <button type="button" class="btn btn-link">¿Olvidó su contraseña?</button>
                </div>
            </fieldset>
        </div>

        <!-- Section TwoFactorCode -->
        <div class="col-md-6 border-start">
            <fieldset id="secondFieldsetLogin" disabled>
                <form method="get" id="emailForm" novalidate>
                    <div class="mb-3">
                        <label asp-for="_emailDTO.email" class="form-label">Correo electrónico:</label>
                        <input asp-for="_emailDTO.email" id="InputEmail" class="form-control" type="email" autocomplete="off" />
                        <span class="text-danger" asp-validation-for="_emailDTO.email"></span>
                    </div>
                    <button type="submit" class="btn btn-primary mb-3">Enviar código</button>
                </form>

                <form method="post" id="twoFactorForm" novalidate>
                    <div class="mb-3">
                        <label asp-for="_CodeTwoFactorDTO.twoFactorCode" class="form-label">Código enviado:</label>
                        <input asp-for="_CodeTwoFactorDTO.twoFactorCode" id="InputTwoFactorCode" class="form-control" 
                               inputmode="numeric" pattern="[0-9]*" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                        <span class="text-danger" asp-validation-for="_CodeTwoFactorDTO.twoFactorCode"></span>
                    </div>
                    <button type="submit" class="btn btn-primary mb-3">Validar código</button>
                </form>
                <a href="#" class="d-block">¿Olvidó cuál es su correo?</a>
            </fieldset>
        </div>
    </div>

    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
        <div id="liveToast" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body" id="toastMessage">
                    Operación exitosa.
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button>
            </div>
        </div>
    </div>
</div>

<script type="module" src="~/js/User/Auth/Login.js"></script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

