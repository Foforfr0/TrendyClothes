@page
@model IndexModel
@{
    ViewData["Title"] = "TrendyClothes";
}

<div class="text-center">
    <div id="carouselClotheTypes" class="carousel slide justify-content-center" data-bs-ride="carousel">
        <div class="carousel-inner w-75">
            <div class="carousel-item active text-center">
                <div class="row justify-content-center">
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <div class="card">
                            <img src="~/images/CarouselExample1.jpg" class="card-img-top" alt="TipoRopa1">
                            <div class="card-body">
                                <h5 class="card-title">Playeras</h5>
                                <a href="#" class="btn btn-primary">Ver</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <div class="card">
                            <img src="~/images/CarouselExample2.jpg" class="card-img-top" alt="TipoRopa2">
                            <div class="card-body">
                                <h5 class="card-title">Suéteres</h5>
                                <a href="#" class="btn btn-primary">Ver</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <div class="card">
                            <img src="~/images/CarouselExample3.jpg" class="card-img-top" alt="TipoRopa3">
                            <div class="card-body">
                                <h5 class="card-title">Pantalones</h5>
                                <a href="#" class="btn btn-primary">Ver</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <div class="card">
                            <img src="~/images/CarouselExample4.jpg" class="card-img-top" alt="TipoRopa4">
                            <div class="card-body">
                                <h5 class="card-title">Tenis</h5>
                                <a href="#" class="btn btn-primary">Ver</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <div class="row">
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <div class="card">
                            <img src="~/images/CarouselExample5.jpg" class="card-img-top" alt="Imagen 5">
                            <div class="card-body">
                                <h5 class="card-title">Gorras</h5>
                                <a href="#" class="btn btn-primary">Ver</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <div class="card">
                            <img src="~/images/CarouselExample6.jpg" class="card-img-top" alt="Imagen 6">
                            <div class="card-body">
                                <h5 class="card-title">Bolsas</h5>
                                <a href="#" class="btn btn-primary">Ver</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <div class="card">
                            <img src="~/images/CarouselExample7.jpg" class="card-img-top" alt="Imagen 7">
                            <div class="card-body">
                                <h5 class="card-title">Accesorios</h5>
                                <a href="#" class="btn btn-primary">Ver</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <div class="card">
                            <img src="~/images/CarouselExample8.jpg" class="card-img-top" alt="Imagen 8">
                            <div class="card-body">
                                <h5 class="card-title">Relojes</h5>
                                <a href="#" class="btn btn-primary">Ver</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#carouselClotheTypes" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Anterior</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselClotheTypes" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Siguiente</span>
        </button>
    </div>
</div>

<section data-testid="discovery" class="discovery" type="discovery">
    <div class="container row">
        <div class="discovery">
            <div class="discovery__body">
                <a class="advertising-square">
                    <div class="advertising-square__info">
                        <span class="advertising-square__info--title">
                            Title
                        </span>
                        <span class="advertising-square__info--text">
                            Texto
                        </span>
                        <span class="advertising-square__info--button andes-button andes-button--small andes-button--loud btn btn-primary">
                            Ver más
                        </span>
                    </div>
                    <div class="advertising-square__img container d-flex justify-content-end align-items-center">
                        <img aria-hidden="true" decoding="async" src="~/images/CarouselExample1.jpg" class alt="Alt"/>
                    </div>
                </a>
                <a class="advertising-square">
