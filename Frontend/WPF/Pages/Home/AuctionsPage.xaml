<Page x:Class="WpfApp.Pages.Home.AuctionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp.Pages.Home"
      xmlns:uc="clr-namespace:WpfApp.Components"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuctionsPage">

    <Border Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Margin="5"
                        Style="{DynamicResource BackButtonStyle}"
                        Click="BtnBack_Click"/>
                <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Glb_Auctions}"
                               Style="{DynamicResource HeaderLabelStyle}"
                               Margin="5, 2" x:Name="PageHeader"/>
                </StackPanel>
            </Grid>
            <!--ItemCards-->
            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="AuctionFeed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" ItemWidth="Auto" ItemHeight="Auto"
                                           Margin="15, 0, 15, 10"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <uc:AuctionCard Margin="10, 10, 30, 10"/>
                                <!--bind-->
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Page>
