<Page x:Class="WpfApp.Pages.User.Profile.UserProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp.Pages.User.Profile"
      xmlns:uc="clr-namespace:WpfApp.Components"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UserProfilePage">

    <Border Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.4*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Left"
                                VerticalAlignment="Top" Margin="10, 10">
                        <TextBlock Text="Datos personales:" Style="{DynamicResource HeaderLabelStyle}"/>
                        <TextBlock x:Name="TbFullName" Style="{DynamicResource DescriptionLabelStyle}"
                                   Margin="0, 20"/>
                        <TextBlock x:Name="TbUsername" Style="{DynamicResource DescriptionLabelStyle}"
                                   Margin="0, 5"/>
                        <TextBlock x:Name="TbEmail" Style="{DynamicResource DescriptionLabelStyle}"
                                   Margin="0, 5"/>
                        <TextBlock x:Name="TbPhone" Style="{DynamicResource DescriptionLabelStyle}"
                                   Margin="0, 5"/>
                        <TextBlock x:Name="TbUserRole" Style="{DynamicResource DescriptionLabelStyle}"/>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="10, 0"
                                Grid.Row="1">
                        <Button x:Name="BtnEditProfile" Content="{DynamicResource Glb_EditProfile}"
                                Style="{DynamicResource TableHeaderButtonStyle}"
                                Click="BtnEditProfile_Click" FontSize="14"
                                HorizontalAlignment="Left" Margin="5, 0"/>
                        <Button x:Name="BtnRegisterProduct" Content="{DynamicResource Glb_RegisterProduct}"
                                Style="{DynamicResource TableHeaderButtonStyle}"
                                Click="BtnRegisterProduct_Click" Margin="5, 5"
                                FontSize="14" HorizontalAlignment="Left"/>
                        <Button x:Name="BtnStartAuction" Content="{DynamicResource Glb_RegisterAuction}"
                                Style="{DynamicResource TableHeaderButtonStyle}"
                                Click="BtnStartAuction_Click" Margin="5, 5"
                                FontSize="14" HorizontalAlignment="Left"/>
                        <Button x:Name="BtnMessages" Content="{DynamicResource Glb_Messages}"
                                Style="{DynamicResource TableHeaderButtonStyle}"
                                Click="BtnMessages_Click" Margin="5, 5"
                                FontSize="14" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.5*"/>
                    <RowDefinition Height="4*"/>
                    <RowDefinition Height="0.5*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Items_Header}"
                               Style="{DynamicResource HeaderLabelStyle}"
                               x:Name="PageHeader"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="25"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ItemsFeed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" ItemHeight="Auto" ItemWidth="250"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <uc:ItemCard2 Margin="15"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                    <Button x:Name="BtnDeletePost" Content="{DynamicResource Glb_Delete}"
                            Style="{DynamicResource DangerButtonStyle}" Margin="0, 0, 20, 0"
                            Click="BtnDeletePost_Click" Visibility="Collapsed"/>
                    <Button x:Name="BtnEditPost" Content="{DynamicResource EditItem_BtnEdit}"
                            Style="{DynamicResource PrimaryButtonNoIconStyle}"
                            Click="BtnEditPost_Click" Margin="0, 0, 15, 0"
                            Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Page>
