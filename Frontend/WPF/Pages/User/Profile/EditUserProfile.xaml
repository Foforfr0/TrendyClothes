<Page x:Class="WpfApp.Pages.User.Profile.EditUserProfile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp.Pages.User.Profile"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EditUserProfile">

    <Border Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.5*"/>
                        <ColumnDefinition Width="8*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnBack" Style="{DynamicResource BackButtonStyle}"
                            Click="BtnBack_Click"/>

                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="15, 0"
                                VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="{DynamicResource EditProfile_Header}"
                                   Style="{DynamicResource HeaderLabelStyle}"/>
                        <TextBlock Text="{DynamicResource EditProfile_Desc}"
                                   Style="{DynamicResource DescriptionLabelStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.4*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                            VerticalAlignment="Top" Margin="10, 0" Grid.Column="0">
                    <Image Name="UserProfilePic" HorizontalAlignment="Center"
                           Width="120" Height="160">
                        <Image.Clip>
                            <EllipseGeometry RadiusX="90" RadiusY="90" Center="90, 90"/>
                        </Image.Clip>
                    </Image>

                    <Button x:Name="BtnModifyImage" Content="{DynamicResource EditProfile_ModifyPic}"
                            Style="{DynamicResource PrimaryButtonNoIconStyle}"
                            Click="BtnModifyImage_Click" Margin="0, 5, 0, 6"/>
                </StackPanel>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="0.5*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Vertical" Margin="10">
                        <TextBlock Text="{DynamicResource RegUser_UserData}"
                                   Style="{DynamicResource DescriptionLabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>

                        <Grid Grid.Column="0" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBox x:Name="TbFirstName" 
                                     Grid.Column="0" Grid.Row="0"
                                     Tag="{DynamicResource RegUser_FirstName}" 
                                     Style="{DynamicResource TextBoxStyle}"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                     Margin="0,0,10,10"
                                     TextChanged="RequiredFields_TextChanged"/>
                            <TextBox x:Name="TbLastName" 
                                     Grid.Column="1" Grid.Row="0"
                                     Tag="{DynamicResource RegUser_LastName}" 
                                     Style="{DynamicResource TextBoxStyle}"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                     Margin="10,0,0,10"
                                     TextChanged="RequiredFields_TextChanged"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Vertical" Margin="10">
                        <TextBlock Text="{DynamicResource RegUser_AccountData}"
                                   Style="{DynamicResource DescriptionLabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <PasswordBox x:Name="PbActualPassword" Grid.Column="0"
                                             Tag="{DynamicResource EditProfile_ActualPassword}"
                                             Style="{DynamicResource PasswordBoxStyle}"
                                             Margin="5"
                                             PasswordChanged="ActualPassword_TextChanged"/>
                                <TextBox x:Name="TbActualPassword" Grid.Column="0"
                                         Tag="{DynamicResource EditProfile_ActualPassword}"
                                         Style="{DynamicResource ShowPasswordStyle}"
                                         Margin="5" Visibility="Collapsed"
                                         TextChanged="ActualPassword_TextChanged"/>
                                <CheckBox x:Name="ChbShowPassword" Margin="10, 5, 0, 0"
                                          Content="{DynamicResource Glb_ShowPassword}"
                                          Style="{DynamicResource CheckBoxStyle}"
                                          IsChecked="False" HorizontalAlignment="Left"
                                          Checked="ChbShowPassword_Checked"
                                          Unchecked="ChbShowPassword_Unchecked"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <PasswordBox x:Name="PbNewPassword" Grid.Column="1"
                                             Tag="{DynamicResource EditProfile_NewPassword}"
                                             Style="{DynamicResource PasswordBoxStyle}"
                                             Margin="5"
                                             PasswordChanged="NewPassword_TextChanged"/>
                                <TextBox x:Name="TbNewPassword" Grid.Column="0"
                                         Tag="{DynamicResource RegUser_RepeatPassword}"
                                         Style="{DynamicResource ShowPasswordStyle}"
                                         Margin="5" Visibility="Collapsed"
                                         TextChanged="NewPassword_TextChanged"/>
                                <CheckBox x:Name="ChbShowConfirmPassword" Margin="10, 5, 0, 0"
                                          Content="{DynamicResource Glb_ShowPassword}"
                                          Style="{DynamicResource CheckBoxStyle}"
                                          IsChecked="False" HorizontalAlignment="Left"
                                          Checked="ChbShowPassword_Checked"
                                          Unchecked="ChbShowPassword_Unchecked"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="20, 0">
                        <Button x:Name="BtnCancel" Style="{DynamicResource SecondaryButtonNoIconStyle}"
                                Content="{DynamicResource Glb_Cancel}"
                                Click="BtnCancel_Click" Margin="0, 0, 15, 0"/>
                        <Button x:Name="BtnEditProfile" Style="{DynamicResource PrimaryButtonNoIconStyle}"
                                Content="{DynamicResource EditProfile_Update}"
                                Click="BtnEditProfile_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Page>
