<Window x:Class="WpfApp.Pages.User.Auth.SignUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp.Pages.User.Auth"
        mc:Ignorable="d"
        Title="SignUpWindow" Height="450" Width="800">
    <Border Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.5*"/>
                        <ColumnDefinition Width="8*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnBack" Content="{DynamicResource Glb_Back}"
                            Style="{DynamicResource BackButtonStyle}" Grid.Column="0"
                            Click="BtnBack_Click"/>

                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center"
                                HorizontalAlignment="Left" Margin="15, 0">
                        <TextBlock Text="{DynamicResource RegUser_Header}" 
                                   Style="{DynamicResource HeaderLabelStyle}"
                                   x:Name="PageHeader"/>
                        <TextBlock Text="{DynamicResource RegUser_Desc}"
                                   Style="{DynamicResource DescriptionLabelStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.4*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                            VerticalAlignment="Top" Margin="0, 10" Grid.Column="0">
                    <Image Name="UserProfilePic" HorizontalAlignment="Center"
                           Width="120" Height="160">
                        <Image.Clip>
                            <EllipseGeometry RadiusX="90" RadiusY="90" Center="90,90"/>
                        </Image.Clip>
                    </Image>

                    <Button x:Name="BtnSelectImage" Content="{DynamicResource Glb_BtnSelectImage}"
                            Style="{DynamicResource PrimaryButtonNoIconStyle}"
                            Click="BtnSelectImage_Click" Margin="0, 5, 0, 6"/>
                    <Button x:Name="BtnDeleteImage" Content="{DynamicResource Glb_BtnDeleteImage}"
                            Style="{DynamicResource DangerButtonStyle}" IsEnabled="False"
                            Click="BtnDeleteImage_Click"/>
                </StackPanel>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="0.5*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Vertical" Margin="10">
                        <TextBlock Text="{DynamicResource RegUser_UserData}"
                                   Style="{DynamicResource DescriptionLabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>

                        <Grid Grid.Column="0" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBox x:Name="TbFirstName" 
                                     Grid.Column="0" Grid.Row="0"
                                     Tag="{DynamicResource RegUser_FirstName}" 
                                     Style="{DynamicResource TextBoxStyle}"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                     Margin="0,0,10,10"
                                     TextChanged="RequiredFields_TextChanged"/>
                            <TextBox x:Name="TbLastName" 
                                     Grid.Column="1" Grid.Row="0"
                                     Tag="{DynamicResource RegUser_LastName}" 
                                     Style="{DynamicResource TextBoxStyle}"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                     Margin="10,0,0,10"
                                     TextChanged="RequiredFields_TextChanged"/>
                            <TextBox x:Name="TbEmailAddress"
                                     Grid.Column="0" Grid.Row="1"
                                     Tag="{DynamicResource Glb_Email}"
                                     Style="{DynamicResource TextBoxStyle}"
                                     Margin="0,0,10,0"
                                     TextChanged="RequiredFields_TextChanged"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Vertical" Margin="10">
                        <TextBlock Text="{DynamicResource RegUser_AccountData}"
                                   Style="{DynamicResource DescriptionLabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <PasswordBox x:Name="PbAccountPassword" Grid.Column="0"
                                         Tag="{DynamicResource RegUser_Password}"
                                         Style="{DynamicResource PasswordBoxStyle}"
                                         Margin="5"
                                         PasswordChanged="Password_TextChanged"/>
                                <TextBox x:Name="TbAccountPassword" Grid.Column="0"
                                        Tag="{DynamicResource RegUser_Password}"
                                        Style="{DynamicResource ShowPasswordStyle}"
                                        Margin="5" Visibility="Collapsed"
                                        TextChanged="Password_TextChanged"/>
                                <CheckBox x:Name="ChbShowPassword" Margin="10, 5, 0, 0"
                                      Content="{DynamicResource Glb_ShowPassword}"
                                      Style="{DynamicResource CheckBoxStyle}"
                                      IsChecked="False" HorizontalAlignment="Left"
                                      Checked="ChbShowPassword_Checked"
                                      Unchecked="ChbShowPassword_Unchecked"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <PasswordBox x:Name="PbConfirmPassword" Grid.Column="1"
                                         Tag="{DynamicResource RegUser_RepeatPassword}"
                                         Style="{DynamicResource PasswordBoxStyle}"
                                         Margin="5"
                                         PasswordChanged="Password_TextChanged"/>
                                <TextBox x:Name="TbConfirmPassword" Grid.Column="0"
                                         Tag="{DynamicResource RegUser_RepeatPassword}"
                                         Style="{DynamicResource ShowPasswordStyle}"
                                         Margin="5" Visibility="Collapsed"
                                         TextChanged="Password_TextChanged"/>
                                <CheckBox x:Name="ChbShowConfirmPassword" Margin="10, 5, 0, 0"
                                          Content="{DynamicResource Glb_ShowPassword}"
                                          Style="{DynamicResource CheckBoxStyle}"
                                          IsChecked="False" HorizontalAlignment="Left"
                                          Checked="ChbShowConfirmPassword_Checked"
                                          Unchecked="ChbShowConfirmPassword_Unchecked"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="20, 0">
                        <Button x:Name="BtnLogin" Style="{DynamicResource SecondaryButtonNoIconStyle}"
                                Content="{DynamicResource Login_Header}"
                                Click="BtnLogin_Click" Margin="0, 0, 15, 0"/>
                        <Button x:Name="BtnRegisterUser" Style="{DynamicResource PrimaryButtonNoIconStyle}"
                                Content="{DynamicResource RegUser_BtnRegister}"
                                Click="BtnRegisterUser_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border x:Name="DialogOverlay"
                    Background="#80000000"
                    Visibility="Collapsed"
                    Panel.ZIndex="100"
                    Grid.RowSpan="2">
            </Border>

            <ContentControl x:Name="DialogHost"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Panel.ZIndex="101"
                            Grid.RowSpan="2"/>
        </Grid>
    </Border>

</Window>
