<Page x:Class="WpfApp.Pages.Auction.RegisterAuctionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp.Pages.Auction"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegisterAuctionPage">

    <Border Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.5*"/>
                        <ColumnDefinition Width="8*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnBack" Content="{DynamicResource Glb_Back}"
                            Style="{DynamicResource BackButtonStyle}" 
                            Click="BtnBack_Click"/>
                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center"
                                HorizontalAlignment="Left" Margin="15, 0">
                        <TextBlock x:Name="PageHeader"
                                   Text="{DynamicResource Glb_RegisterAuction}"
                                   Style="{DynamicResource HeaderLabelStyle}"/>
                        <TextBlock x:Name="PageDescription"
                                   Text="{DynamicResource Auction_Desc}"
                                   Style="{DynamicResource DescriptionLabelStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.4*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Center"
                            VerticalAlignment="Top" Margin="0, 10">
                    <Image Name="AuctionItemPic" HorizontalAlignment="Center"
                           Width="120" Height="130"/>
                    <Button x:Name="BtnSelectImage" Content="{DynamicResource Glb_BtnSelectImage}"
                            Style="{DynamicResource PrimaryButtonNoIconStyle}"
                            Click="BtnSelectImage_Click" Margin="0, 5"/>
                    
                    <Button x:Name="BtnDeleteImage" Content="{DynamicResource Glb_BtnDeleteImage}"
                            Style="{DynamicResource DangerButtonStyle}" IsEnabled="False"
                            Click="BtnDeleteImage_Click" Margin="0, 5"/>
                    
                    <!--pujas-->
                    
                </StackPanel>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Vertical" Margin="10">
                        <TextBlock Text="{DynamicResource RegItem_ItemDesc}"
                                   Style="{DynamicResource DescriptionLabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>

                        <Grid Grid.Column="0" HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="TbAuctionTitle" Grid.Row="0"
                                     Tag="{DynamicResource RegItem_ItemTitle}"
                                     Style="{DynamicResource RegularLabelStyle}" Margin="0, 5, 50, 10"/>
                            <TextBlock x:Name="TbAuctionDesc" Grid.Row="1"
                                     Tag="{DynamicResource RegItem_Desc}"
                                     Style="{DynamicResource RegularLabelStyle}" Margin="0, 5, 50, 10"
                                     Height="70"/>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="10">
                            <TextBlock Text="{DynamicResource Auction_PriceDetails}"
                                       Style="{DynamicResource DescriptionLabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0, 5"
                                            VerticalAlignment="Center">
                                    <TextBox x:Name="TbStartPrice" Tag="{DynamicResource Auction_StartingPrice}"
                                             Style="{DynamicResource TextBoxStyle}"
                                             TextChanged="RequiredFields_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                            HorizontalAlignment="Center" Margin="10, 0">
                                    <TextBox x:Name="TbLowestBid" Tag="{DynamicResource Auction_LowestBid}"
                                             Style="{DynamicResource TextBoxStyle}"
                                             TextChanged="RequiredFields_TextChanged" Margin="15, 0"
                                             Width="100"/>                                    
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="10"
                                    HorizontalAlignment="Left">
                            <ComboBox x:Name="CbAuctionDuration" Width="200"
                                      Style="{DynamicResource ComboBoxStyle}"
                                      Tag="{DynamicResource Auction_Duration}"
                                      SelectionChanged="CbAuctionDuration_SelectionChanged"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="20, 0">
                        <Button x:Name="BtnCancel" Style="{DynamicResource SecondaryButtonNoIconStyle}"
                                Content="{DynamicResource Glb_Cancel}" Margin="15, 0"
                                Click="BtnCancel_Click"/>
                        <Button x:Name="BtnStartAcution" Style="{DynamicResource PrimaryButtonNoIconStyle}"
                                Content="{DynamicResource Auction_Start}"
                                Click="BtnStartAcution_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Page>
