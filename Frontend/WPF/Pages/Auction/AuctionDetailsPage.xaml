<Page x:Class="WpfApp.Pages.Auction.AuctionDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp.Pages.Auction"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuctionDetailsPage">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.2*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="0.5*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Image Name="AuctionItemPic" Margin="15, 15" Grid.Row="0"
                               HorizontalAlignment="Center" Stretch="Uniform"
                               Source="/Resources/Images/image-empty.jpg"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality">
                        </Image>

                        <!--Temporizador-->
                        <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" Margin="15">
                            <TextBlock Text="{DynamicResource Auction_TimeLeft}"/>
                            <TextBlock x:Name="TbAuctionTimer"
                                       Style="{DynamicResource AuctionTimerStyle}"
                                       Text="00:00:00"
                                       Margin="10, 15, 0, 50"/>
                            
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Vertical" VerticalAlignment="Top"
                                    HorizontalAlignment="Left">
                            <TextBlock Name="AuctionTitle" Text="{DynamicResource Auction_Title}"
                                       Style="{DynamicResource SubtitleLabelStyle}"
                                       Margin="0, 20"/>
                            <TextBox Name="AuctionDesc" Text="{DynamicResource Auction_Description}"
                                       Style="{DynamicResource TextAreaStyle}" MaxHeight="150"
                                       MaxWidth="350" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                        <Border Grid.Row="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Vertical" HorizontalAlignment="Left"
                                        Margin="5" Grid.Column="0" VerticalAlignment="Top">
                                    <TextBlock Text="{DynamicResource Auction_ActualPrice}"
                                           Style="{DynamicResource SubtitleLabelStyle}"
                                           Margin="0, 0, 0, 10"/>
                                    <TextBlock Name="TbActualPrice" Text="00.00"
                                           Style="{DynamicResource HeaderLabelStyle}"
                                           FontSize="24" Margin="0, 0, 0, 40"/>                                    
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top"
                                            HorizontalAlignment="Left" Margin="5">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                HorizontalAlignment="Left">
                                        <TextBlock Text="{DynamicResource Auction_LowestBid}"
                                                   Style="{DynamicResource DescriptionLabelStyle}"
                                                   Margin="0, 0, 5, 0"/>
                                        <TextBlock Name="TbLowestBid" Text="00.00"
                                                   Style="{DynamicResource DescriptionLabelStyle}"/>
                                    </StackPanel>
                                     
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" 
                                                HorizontalAlignment="Left" Margin="0">
                                        <Button Width="120" Height="30" Content="Hacer puja"
                                                Style="{DynamicResource SecondaryButtonNoIconStyle}"
                                                Click="IncreaseBid_Click"
                                                Margin="15,0"/>

                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    VerticalAlignment="Center" HorizontalAlignment="Right">
            <Button x:Name="BtnCancelBid"
                    Style="{DynamicResource SecondaryButtonNoIconStyle}"
                    Content="{DynamicResource Auction_CancelBid}"
                    Margin="0, 0, 15, 0"
                    Click="BtnCancelBid_Click"/>            
        </StackPanel>
    </Grid>
</Page>
