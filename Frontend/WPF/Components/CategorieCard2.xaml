<UserControl x:Class="WpfApp.Components.CategorieCard2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp.Components"
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="300">
    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="12">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="ImageCategory"
                       Source="/Resources/Images/CarouselExample1.jpg"
                       Stretch="Fill"
                       Height="110" Width="120"/>
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="5">
                <Button x:Name="BtnCategory" Content="CATEGORIA"
                        Style="{DynamicResource SecondaryButtonNoIconStyle}"
                        Click="BtnCategory_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
