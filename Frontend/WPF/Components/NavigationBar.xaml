<UserControl x:Class="WpfApp.Components.NavigationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp.Components" mc:Ignorable="d" 
             Height="20" Width="1000">
    <Border BorderBrush="LightGray" BorderThickness="0 1">
        <Grid>
            <Grid.Background>
                <SolidColorBrush Color="#FFFFFF"/>
            </Grid.Background>
            <StackPanel Orientation="Horizontal" Margin="10 0">
                <Button Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                Margin="0 0 8 0" Click="BtnGoBack" x:Name="BtnBack">
                    <Image Source="/Resources/Icons/icon-left-arrow.png" Width="18"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
