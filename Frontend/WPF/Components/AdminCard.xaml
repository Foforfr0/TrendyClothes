<UserControl x:Class="WpfApp.Components.AdminCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp.Components"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="300">
    <Border Background="{StaticResource SecondaryBrush}" CornerRadius="12"
            MouseLeftButtonDown="Border_MouseLeftButtonDown"
            Cursor="Hand">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Image x:Name="MsgImage"
                       Source="/Resources/Icons/email-icon.png"
                       Stretch="Fill"
                       Height="60"
                       Width="70"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <TextBlock Text="Reportes" Margin="50, 0, 10, 0"
                           Style="{DynamicResource HeaderLabelStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
