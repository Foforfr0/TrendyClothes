<UserControl x:Class="WpfApp.Components.ItemCard2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp.Components"
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="220">
    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="12"
            MouseLeftButtonDown="Border_MouseLeftButtonDown"
            Cursor="Hand" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Image x:Name="ItemImage"
                       Source="/Resources/Images/image-empty.jpg"
                       Stretch="Fill"
                       Height="70" Width="90"/>
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Orientation="Vertical" Margin="10">
                <TextBlock Name="TbPostTitle"
                           Text="{Binding Name}"
                           Style="{DynamicResource SubtitleLabelStyle}"
                           Margin="0, 10, 0, 5"/>
                <TextBlock Name="TbPostPrice"
                           Text="{Binding Price, StringFormat=C}"
                           Style="{DynamicResource RegularLabelStyle}"/>
                <TextBlock x:Name="TbSold" Text="{Binding NumberSold, StringFormat={}{0} sold}"
                           Margin="0, 15, 0 , 0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
