<UserControl x:Class="WpfApp.Components.ItemCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp.Components"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="130">
    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="10, 5">
                <Image Grid.Row="0" Name="ItemPic" HorizontalAlignment="Center"
                       Width="64" Height="64" Stretch="Fill" Source="{Binding ImagePath}"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Clip>
                        <EllipseGeometry RadiusX="28" RadiusY="28" Center="28,28"/>
                    </Image.Clip>
                </Image>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Left"
                        Margin="5, 5">
                <TextBlock x:Name="ItemName" Text="{Binding Name}" Style="{StaticResource SubtitleLabelStyle}"/>
                <TextBlock x:Name="ItemPrice" Text="{Binding Price}" Style="{StaticResource DescriptionLabelStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
