<UserControl x:Class="WpfApp.Components.Carousel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp.Components"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="1000">
    <Border Background="{DynamicResource BackgroundBrush}" HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="BtnLeft"
                    Style="{DynamicResource BackButtonStyle}"
                    Click="BtnLeft_Click"
                    Margin="10"/>

            <ContentControl x:Name="CardHost"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

            <Button Grid.Column="2" x:Name="BtnRight"
                    Style="{DynamicResource ForwardButtonStyle}"
                    Click="BtnRight_Click"
                    Margin="10"/>
        </Grid>
    </Border>
</UserControl>
