<UserControl x:Class="WpfApp.Components.AuctionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp.Components"
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="220">
    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="12" 
            MouseLeftButtonDown="Border_MouseLeftButtonDown"
            Cursor="Hand" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="AuctionImage"
                       Source="/Resources/Images/image-empty.jpg"
                       Stretch="Fill"
                       Height="110" Width="120"/>
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Orientation="Vertical" Margin="10">
                <TextBlock Name="TbAuctionTItle"
                           Text="TITULO"
                           Style="{DynamicResource SubtitleLabelStyle}"
                           Margin="0, 10, 0, 0"/>
                <TextBlock Name="TbActualPrice"
                           Text="00.00" Margin="0, 10, 0 ,10"
                           Style="{DynamicResource RegularLabelStyle}"/>
                <TextBlock Name="TbTimeLeft"
                           Text="00:00"
                           Style="{DynamicResource DescriptionLabelStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
