<UserControl x:Class="WpfApp.Components.CategorieCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp.Components"
             mc:Ignorable="d">
    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="10" Padding="10" Margin="5" Height="260" Width="200">
        <StackPanel>
            <Image x:Name="ImageCategory" 
                   Source="{Binding ImageSource, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" 
                   Height="150" Width="175" Stretch="Uniform"
                   />
            <TextBlock 
                Text="{Binding CategoryName, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" 
                FontWeight="Bold" FontSize="20" Margin="0,5" HorizontalAlignment="Center"/>
            <Button Click="ClickShowCategory" Content="Ver" 
                    Background="#0B5ED7" Padding="5 4" Foreground="#FFFFFF"
                    MaxWidth="100"/>
        </StackPanel>
    </Border>
</UserControl>
