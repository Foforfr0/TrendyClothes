@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@inject WebPage.Connections.ServicesBuilder UrlBuilder
@{
    ViewData["Title"] = "TrendyClothes";
}

<!DOCTYPE html>
<html lang="es-mx">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css"/>
    <link rel="stylesheet" href="~/css/components/Navbar.css"/>
    <link rel="stylesheet" href="~/css/pages/Products.css"/>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />  
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.0/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" >
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">TrendyClothes</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Index">Inicio</a> <!--TODO-->
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Product/Seller/EditProduct">Categorías</a> <!--TODO-->
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Auction/Participant/ConsultAuctions">Subastas</a> <!--TODO-->
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Index">Moda</a> <!--TODO-->
                        </li>
                    </ul>
                </div>
                <div class="input-group search-box">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" id="searchInput" class="form-control" placeholder="Buscar productos...">
                </div>
                <a class="nav-link text-dark me-3" asp-page="/Index">
                    <img src="~/images/shoppingCart.png" class="profile-img" alt="Perfil" />
                </a>
                <div class="dropdown">
                    <button class="btn btn-transparent dropdown-toggle p-1" type="button">
                        <i class="bi bi-person-circle fs-3"></i>
                    </button>
                    <ul class="dropdown-menu">
                        @if(User.Identity != null && User.Identity.IsAuthenticated){
                            <li><a class="dropdown-item" asp-page="/User/Profile/ViewMyProfile">Ver perfil</a></li>
                            <li><a class="dropdown-item" asp-page="">Lista de deseos</a></li>
                            <li><a class="dropdown-item" asp-page="">Favoritos</a></li>
                            <li><a class="dropdown-item" asp-page="/Product/Seller/ConsultMyProducts" asp-route-username="@User.Identity.Name">Mis productos</a></li>
                            <form method="post" asp-page="/User/Auth/Login" asp-page-handler="Logout" id="logoutForm" class="d-inline">
                                <li><a href="javascript:void(0);" class="dropdown-item" onclick="document.getElementById('logoutForm').submit();">Cerrar sesión</a></li>
                            </form>
                        }else{
                            <li><a class="dropdown-item" asp-page="/User/Auth/CreateAccount">Crear cuenta</a></li>
                            <li><a class="dropdown-item" asp-page="/User/Auth/Login">Iniciar sesión</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container text-center mb-2">
        <main role="main">
            <div class="container text-center px-2 pt-2 pb-3 bg-white row d-flex" style="min-height: 75dvh; height: auto;">
                <div class="col-12">
                    @RenderBody()
                </div>
            </div>
        </main>
    </div>

    <footer class="footer border-top text-muted box-shadow bg-white d-block align-content-center mb-0 bottom-100" style="min-height: 10dvh;">
        <div class="container">
            &copy; 2025 - TrendyClothes
        </div>
    </footer>

    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
        <div class="toast-container position-static">
            <div id="liveToast" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body" id="toastMessage"></div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button>
                </div>
            </div>
        </div>
    </div>

    <div class="position-fixed top-50 start-50 translate-middle z-1050 d-none" id="confirmationToastContainer" style="min-width: 300px;">
        <div id="confirmationToast" class="toast show" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="false">
            <div class="toast-body text-center">
                <span>¿Estás seguro de que deseas continuar?</span>
                <div class="mt-3 d-flex justify-content-around">
                    <button type="button" class="btn btn-success btn-sm" id="btnConfirm">Aceptar</button>
                    <button type="button" class="btn btn-danger btn-sm" id="btnCancel">Cancelar</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        window.config = {
            logoutUrl: '@UrlBuilder.UserPostLogoutUrl'
        };
    </script>
    <script type="module" src="~/js/site.js"></script>
    <script type="module" src="~/js/Layout.js"></script>

    @await RenderSectionAsync("Styles", required: false)
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
