@model WebPage.DTO.Auction.MyAuctionsDTO

<style>
    .auction-rectangle {
        border: 1px solid #ccc;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
        background-color: #fff;
        box-shadow: 2px 2px 5px rgba(0,0,0,0.05);
    }

    .auction-flex {
        display: flex;
        gap: 15px;
        align-items: center;
    }

        .auction-flex img {
            width: 150px;
            height: 150px;
            object-fit: cover;
            border-radius: 4px;
        }

    .auction-info {
        text-align: left;
        flex: 1;
    }

        .auction-info h5 {
            margin: 0 0 5px;
        }

        .auction-info p {
            margin: 0;
            font-size: 14px;
        }

        .auction-info .btn {
            margin-top: 8px;
        }
</style>

<div class="auction-rectangle">
    <div class="auction-flex">
        <div>
            @if (!string.IsNullOrEmpty(Model.ImageBase64) && !string.IsNullOrEmpty(Model.MimeImage))
            {
                <img src="data:@Model.MimeImage;base64,@Model.ImageBase64" alt="Producto" />
            }
            else
            {
                <img src="https://placehold.co/150x150?text=Sin+imagen" alt="Sin imagen" />
            }
        </div>
        <div class="auction-info">
            <h5><strong>@Model.Name</strong></h5>
            <p>$@Model.FirstPrice precio inicial</p>
            <p>@Model.BidsCount pujas realizadas</p>
            <p><strong>$@Model.LastPrice</strong> precio final</p>
            <p>@Model.DateStart.ToString("dd/MM/yyyy HH:mm") fecha de inicio</p>
            <p>@Model.DateEnd.ToString("dd/MM/yyyy HH:mm") fecha de fin</p>
            <p>Estado: <strong>@Model.Status</strong></p>
            <a href="/Auction/Auctioneer/ViewDetails?id=@Model.Id" class="btn btn-primary btn-sm">Detalles</a>
        </div>
    </div>
</div>
