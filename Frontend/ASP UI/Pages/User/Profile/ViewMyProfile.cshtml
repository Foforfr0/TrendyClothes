@page
@model WebPage.Pages.User.Profile.ViewMyProfileModel
@{
    ViewData["Title"] = "Perfil de usuario";
}

<p>User.Identity: @(User.Identity != null)</p>
<p>User.Identity.IsAuthenticated: @User.Identity?.IsAuthenticated</p>
<p>User.Identity.Name: @User.Identity?.Name</p>

<h1 class="text-center mb-3">Perfil de usuario</h1>
<div class="container text-center">
    <!-- Personal data -->
    <div class="row">
        <div class="col">
            <table class="table table-striped table-bordered">
                <thead>
                <th class="bg-primary text-white" colspan="2"><h3>Datos personales</h3></th>
                </thead>
                <tbody>
                    <tr>
                        <th>Nombre completo:</th>
                        <td id="fullName"></td>
                    </tr>
                    <tr>
                        <th>Nombre de usuario:</th>
                        <td id="username"></td>
                    </tr>
                    <tr>
                        <th>Correo electrónico:</th>
                        <td id="email"></td>
                    </tr>
                    <tr>
                        <th>Número de teléfono:</th>
                        <td id="phoneNumber"></td>
                    </tr>
                    <tr>
                        <th>Tipo de usuario:</th>
                        <td><span id="role" class="badge bg-info"></span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <!-- Addresses -->
    <div class="row">
        <div class="col">
            <table class="table table-striped table-bordered table-responsive">
                <thead>
                <th class="bg-primary text-white"><h3>Activa</h3></th>
                <th class="bg-primary text-white"><h3>Dirección</h3></th>
                </thead>
                <tbody id="addressesTableBody">
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Botón para iniciar subasta -->
<div class="text-center mt-5">
    <h2 class="mb-4">Subastar productos</h2>
    <button id="startAuction" class="btn btn-secondary btn-lg">Iniciar subasta</button>
</div>

<script type="module" src="~/js/User/ViewMyProfile.js"></script>
