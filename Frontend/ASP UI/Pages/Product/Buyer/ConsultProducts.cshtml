@page
@using AuctionParticipantService.Models
@using WebPage.DTO.Auction
@model WebPage.Pages.Auction.ConsultAuctionsModel

@{
    ViewData["Title"] = "Subastas Activas";
}

<div class="container w-75">
    <div class="row text-center px-auto">
        <h2 class="text-start col-12 px-auto">Subastas disponibles</h2>
    </div>
</div>

@if (Model.Auctions?.Count > 0)
{
    <div class="row" id="auctionsContainer">
        @foreach (AuctionDTO auction in Model.Auctions)
        {
            @await Html.PartialAsync("ConsultAuctionPartial", auction).ConfigureAwait(false)
            ;
        }
    </div>
}
else
{
    <p>No hay subastas activas en este momento.</p>
}