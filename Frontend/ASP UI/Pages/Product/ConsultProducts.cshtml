@page
@using WebPage.DTO.Product.Consult;
@model WebPage.Pages.Product.ConsultProductsModel
@{
    ViewData["Title"] = "Resultados de búsqueda";
}

<div class="container w-75">
    <div class="row text-center px-auto">
        <h2 class="text-start col-12 px-auto">Búsqueda de productos</h2>
        <h4 class="text-start my-3 col-12">Resultados para: "@Model.query"</h4>
    </div>
</div>

@if (Model.Products?.Count > 0) {
    <div class="row" id="productsContainer">
        @foreach (SearchProductsDTO product in Model.Products) {
            @await Html.PartialAsync("ConsultProductsPartial", product).ConfigureAwait(false);
        }
    </div>
}
else {
    <p>No se encontraron productos.</p>
}

<script type="module" src="~/js/Product/ConsultProducts.js"></script>