@page
@model WebPage.Pages.Product.ViewDetailsModel
@{
    ViewData["Title"] = "Detalles de producto.";
}

<div class="container h-100">
    <div class="row h-100">
        <div class="col-4 d-block align-items-center justify-content-center">
            <img class="h-100 object-fit-contain" alt="Producto" src="data:@Model.product.mimeImage;base64,@Model.product.imageBase64" />
        </div>
        <div class="col-8 text-start d-block align-content-top">
            <h2 class="align-content-start truncate-two-lines text-start">@Model.product.name</h2>
            <div class="row mt-2">
                <div class="col">
                    <div><strong>Stock restante: </strong>@Model.product.stockAvailable</div>
                    <div>$@Model.product.price</div>
                </div>
                <div class="col text-end">
                    <div class="container d-flex justify-content-end align-items-center" style="height: 3em;">
                        <input class="me-1 p-1" style="width: 2.5em; height: 2em;" type="number" />
                        <button type="button" class="btn btn-secondary p-1 fs-6">
                            <img width="24" alt="shopping-cart--v2" src="https://img.icons8.com/pastel-glyph/64/FFFFFF/shopping-cart--v2.png" />
                        </button>
                    </div>
                </div>
            </div>
            <div class="container text-start mt-3">
                <h3>Descripción</h3>
                <div>lorem ipsonpoud oasdh aóisdha áoishd a´sodih as´doiha doaishd aosidh a´soihd ax</div>
            </div>
        </div>
    </div>
</div>