@page
@model WebPage.Pages.Product.Seller.ViewDetailsModel
@{
    ViewData["Title"] = "Detalles de producto.";
}

<div class="container h-100">
    <div class="row h-100">
        <div class="col-4 d-block align-items-center justify-content-center">
            @if (Model.product.imageBase64 == null || Model.product.imageBase64.Length <= 0) {
                <img src="https://placehold.co/600x400/FFFFFF/000000/png?text=Product" class="h-100 object-fit-contain" style="max-width: 100%;" alt="Producto" />
            } else {
                <img class="h-100 object-fit-contain" style="max-width: 100%;" alt="Producto" src="data:@Model.product.mimeImage;base64,@Model.product.imageBase64" />
            }
        </div>
        <div class="col-8 text-start d-block align-content-top border-start">
            <div class="row">
                <h2 class="align-content-start truncate-two-lines text-start col">@Model.product.name</h2>
                <a class="col-auto text-end btn text-white py-0 px-1 align-content-center" style="background-color: aquamarine"
                    asp-page="/Product/Seller/EditPublication" asp-route-id="@Model.product.id">
                    <i class="bi bi-gear">&ensp;Modificar</i>
                </a>
            </div>
            <div class="row mt-2 ms-2">
                <div class="col">
                    @if (Model.product.discount > 0)
                    {
                        <div class="row">
                            <div class="col-auto p-0 fw-bold">Precio:&nbsp;</div>
                            <div class="col-auto p-0 text-decoration-line-through">$@Model.product.price</div>&nbsp;-&nbsp;
                            <div class="col p-0">
                                $@(((double)(Model.product.price - (Model.product.price * Model.product.discount / 100)??0)).ToString("F2")) 
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-auto p-0 fw-bold">Descuento:&nbsp;</div>
                            <div class="col p-0 text-success">@Model.product.discount % off</div>
                        </div>
                    }
                    else
                    {
                        <div class="row w-auto">
                            <div class="col-auto p-0 fw-bold">Precio:&nbsp;</div>
                            <div class="col p-0">$@Model.product.price</div>
                        </div>
                    }
                    <div class="row">
                        <div class="col-auto p-0 fw-bold">Stock restante:&nbsp;</div>
                        <div class="col p-0">@Model.product.stockAvailable</div>
                    </div>
                    <div class="row">
                        <div class="col-auto p-0 fw-bold">Vendidos:&nbsp;</div>
                        <div class="col p-0">@Model.product.numberSold</div>
                    </div>
                </div>
                <div class="col text-end">
                    <div class="row text-end">
                        <p class="col my-auto text-end">
                            @Model.product.averageStars / 5.0
                            <i class="bi bi-star-half"></i>
                        </p>
                    </div>
                </div>
            </div>
            <div class="container row align-content-center justify-content-center align-items-center">
                <div class="col-auto fw-bold">Etiquetas:&nbsp;</div>
                <a class="col-auto btn btn-primary border-primary p-1 mx-auto" asp-page="/Product/Buyer/ConsultProducts" asp-route-query="@Model.product.category">@Model.product.category</a>
                <a class="col-auto btn btn-secondary border-secondary p-1 mx-auto" asp-page="/Product/Buyer/ConsultProducts" asp-route-query="@Model.product.type">@Model.product.type</a>
                @if (Model.product.statusId == 1)
                {
                    <a class="col-auto btn btn-success border-success p-1 mx-auto">@Model.product.status</a>
                }
                else if (Model.product.statusId == 2)
                {
                    <a class="col-auto btn btn-danger border-danger p-1 mx-auto">@Model.product.status</a>    
                }
            </div>
            <div class="container text-start mt-2">
                <h3>Descripción</h3>
                <div>@Model.product.description</div>
            </div>
        </div>
    </div>
</div>