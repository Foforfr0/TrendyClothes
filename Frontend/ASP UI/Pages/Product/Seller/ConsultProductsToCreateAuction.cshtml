@page
@using WebPage.DTO.Product.MyProducts
@model WebPage.Pages.Product.Seller.ConsultProductsToCreateAuctionModel
@{
    Layout = null;
}

<div class="modal-header">
    <h5 class="modal-title">Seleccionar Producto para Subasta</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
    <!-- Barra de búsqueda -->
    <div class="mb-3">
        <div class="input-group">
            <span class="input-group-text">
                <i class="bi bi-search"></i>
            </span>
            <input type="text" class="form-control" placeholder="Buscar producto..." id="searchInput">
        </div>
    </div>
    <!-- Toggle para vista -->
    <div class="mb-3">
        <div class="btn-group btn-group-sm" role="group">
            <input type="radio" class="btn-check" name="viewMode" id="listView" checked>
            <label class="btn btn-outline-primary" for="listView">
                <i class="bi bi-list"></i> Lista
            </label>

            <input type="radio" class="btn-check" name="viewMode" id="gridView">
            <label class="btn btn-outline-primary" for="gridView">
                <i class="bi bi-grid"></i> Grid
            </label>
        </div>
    </div>
    <!-- Contenedor de productos -->
    <div id="productsContainer" class="products-list">
        @foreach (MyProductsDTO item in Model.Products) {
            <div class="product-item"
                 data-product-id="@item.id"
                 data-product-name="@item.name"
                 data-product-price="@item.price"
                 data-product-description="@("Sin descripción disponible")"
                 data-product-status="@item.status">
                @if (item.imageBase64 == null || item.imageBase64.Length <= 0) {
                    <img src="https://placehold.co/600x400/FFFFFF/000000/png?text=Product" alt="@item.name" class="product-image" />
                } else {
                    <img src="data:@item.mimeImage;base64,@item.imageBase64" alt="@item.name" class="product-image">
                }
                <div class="product-content">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            <h6 class="product-title">@item.name</h6>
                            <p class="product-description mb-2">
                                Sin descripción disponible para este producto.
                            </p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="product-price">$@item.price</span>
                                <span class="product-status @(GetStatusClass(item.status))">@item.status</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="selection-indicator">
                    <i class="bi bi-check-lg"></i>
                </div>
            </div>
        }
    </div>
</div>
<div class="modal-footer position-sticky sticky-bottom bottom-0 bg-white">
    <button type="button" class="btn btn-secondary" id="cancelModal" data-bs-dismiss="modal">Cancelar</button>
    <button type="button" class="btn btn-primary" id="confirmSelection" disabled>
        Seleccionar Producto
    </button>
</div>

<!-- Toast Container -->
<div class="toast-container" id="toastContainer"></div>
@functions {
    private string GetStatusClass(string status)
    {
        if (string.IsNullOrEmpty(status)) return "status-available";
        
        var statusLower = status.ToLower();
        if (statusLower.Contains("Activo") || statusLower.Contains("activo"))
            return "status-available";
        else if (statusLower.Contains("Pausado") || statusLower.Contains("pausado"))
            return "status-low-stock";
        else if (statusLower.Contains("Cancelado") || statusLower.Contains("cancelado"))
            return "status-out-of-stock";
        
        return "status-available";
    }
}

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const cancelButton = document.getElementById('cancelModal');
        
        cancelButton.addEventListener('click', () => {
            // Redirigir a la página de perfil
            window.location.replace("/User/Profile/ViewMyProfile");
        });
    });
    // Ensure the script is loaded
    if (typeof initializeProductSelector === 'function') {
        initializeProductSelector();
    }
</script>
