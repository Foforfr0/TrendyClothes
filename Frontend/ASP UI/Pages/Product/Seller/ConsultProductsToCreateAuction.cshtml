@page
@using WebPage.DTO.Product.MyProducts
@model WebPage.Pages.Product.Seller.ConsultProductsToCreateAuctionModel
@{
    Layout = null;
}


<div class="modal-header d-flex justify-content-between align-items-center">
    <h3 class="mb-0">Crear subasta</h3>
    <div class="d-flex align-items-center">
        <h5 class="mb-0 me-3">Seleccione un producto</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
</div>


<div class="modal-body">
    <div class="row">
        @foreach (MyProductsDTO item in @Model.Products) {
            <button class="list-group-item list-group-item-action" data-id="@item.id"></button>
        }   
    </div>
</div>

<div class="modal-footer">
    <div class="row align-items-center">
        <input type="hidden" class="d-none" name="idProductSelected" id="idProductSelected" />
        <button type="button" class="col-auto btn btn-danger w-auto me-3" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="col-auto btn btn-success w-auto">Seleccionar</button>
    </div>
</div>

@section Styles {
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/pages/Products.css" />
}