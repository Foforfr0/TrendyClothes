{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Services": {
    "REST": {
      "User": {
        "Auth": {
          "BaseUrl": "https://localhost:5001",
          "Login": {
            "Login": "/api/User/Login",
            "ValidateEmailUser": "/api/User/Login/ValidateEmailUser",
            "PostTwoFactorCode": "/api/User/Login/CreateTwoFactorCode",
            "ValidateTwoFactorCode": "/api/User/Login/ValidateTwoFactorCode",
            "DeleteTwoFactorCode": "/api/User/Login/DeleteTwoFactorCode"
          },
          "Logout": "/api/User/Logout"
        },
        "Profile": {
          "BaseUrl": "https://localhost:5001",
          "GetPersonalData": "/api/User/ViewProfile/GetPersonalData",
          "GetAddresses": "/api/User/ViewProfile/GetAddresses"
        },
        "Account": {
          "BaseUrl": "https://localhost:5001",
          "PostAccount": "/api/User/Registration",
          "DeleteAccount": "/api/User/DeleteAccount",
          "ValidateUserData": {
            "ExistenceUsername": "/api/User/ValidateUserData/VerifyExistenceUsername",
            "ExistenceEmail": "/api/User/ValidateUserData/VerifyExistenceEmail",
            "ExistencePhoneNumber": "/api/User/ValidateUserData/VerifyExistencePhoneNumber"
          }
        }
      },
      "Product": {
        "BaseUrl": "https://localhost:5001",
        "Seller": {
          "GetProducts": "/api/MyProducts/Search",
          "GetDetailsProduct": "/api/MyProducts/Details",
          "PutDetailsProduct":  "/api/MyProduct/Edit"
        },
        "Buyer": {
          "GetProducts": "/api/Product/Search",
          "GetDetailsProduct": "/api/Product/Details"
        },
        "Tags": {
          "GetCategories": "api/Product/Tags/Categories",
          "GetTypes": "api/Product/Tags/Types",
          "GetStatusses": "api/Product/Tags/Statusses"
        }
      },
      "Auction": {
        "BaseUrl": "https://localhost:5001",
        "Auctioneer": {
          "PostAuction": "/api/Auction/Auctioneer/CreateAuction",
          "GetAuctions": "/api/Auction/Auctioneer/ConsultMyAuction/MyAuctions",
          "GetDetailsAuction": "/api/Auction/Auctioneer/ConsultMyAuction/ViewMyAuctionDetails",
          "PatchAuction": "/api/Auction/Auctioneer/UpdateAuction"
        },
        "Participant": {
          "GetAuctions": "/api/Auction/Participant/ConsultAuction/Search",
          "GetDetailsAuction": "/api/Auction/Participant/ConsultAuction/ViewDetails",
          "PostBid": "/api/Auction/Participant/CreateBid"
        }
      }
    },
    "gRPC": {
      "BaseUrl": "https://localhost:5002"
    }
  }
}
