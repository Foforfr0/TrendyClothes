<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClienteMAUI.Views.AuctionsMenuPage"
             Title="Subastas Activas">

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="20">

            <Label Text="Subastas activas"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <!-- Lista de subastas -->
            <CollectionView x:Name="AuctionsCollection"
                            ItemsLayout="VerticalGrid, 2"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="LightGray" StrokeThickness="1" Padding="10" Margin="5" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout>
                                <Image Source="{Binding ImageSource}" HeightRequest="100" Aspect="AspectFill"/>
                                <Label Text="{Binding ProductName}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding FirstPriceText}" FontSize="14" />
                                <Label Text="{Binding LastPriceText}" FontSize="14" />
                                <Label Text="{Binding BidText}" FontSize="14" />
                                <Label Text="{Binding EndDateFormatted}" FontSize="12" />
                                <Button Text="Pujar"
                                        BackgroundColor="Green"
                                        TextColor="White"
                                        Clicked="OnPujarClicked"
                                        CommandParameter="{Binding Id}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="lblNoAuctions"
                   Text="No hay subastas activas disponibles."
                   IsVisible="False"
                   HorizontalOptions="Center"
                   FontAttributes="Italic" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
