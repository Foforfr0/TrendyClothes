<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClienteMAUI.Views.PayFormPage"
             Title="Pago del producto">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Resumen del producto -->
            <Border Stroke="LightGray" StrokeThickness="1" BackgroundColor="#f5f5f5" Padding="10" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="5">
                    <Image x:Name="ProductImage" HeightRequest="150"/>
                    <Label x:Name="ProductNameLabel" FontSize="20" FontAttributes="Bold"/>
                    <Label x:Name="ProductPriceLabel" FontSize="18" TextColor="Green"/>
                </VerticalStackLayout>
            </Border>


            <!-- Formulario de datos del comprador -->
            <Entry Placeholder="Nombre completo" x:Name="NameEntry"/>
            <Entry Placeholder="Dirección" x:Name="AddressEntry"/>
            <Entry Placeholder="Correo electrónico" x:Name="EmailEntry" Keyboard="Email"/>
            <Entry Placeholder="Teléfono" x:Name="PhoneEntry" Keyboard="Telephone"/>
            <Entry Placeholder="Número de tarjeta" x:Name="CardNumberEntry" Keyboard="Numeric"/>
            <Entry Placeholder="Fecha de expiración (MM/AA)" x:Name="ExpirationEntry"/>
            <Entry Placeholder="CVV" x:Name="CVVEntry" IsPassword="True" Keyboard="Numeric"/>

            <!-- Botón para confirmar -->
            <Button Text="Confirmar compra"
                    BackgroundColor="#007AFF"
                    TextColor="White"
                    Clicked="OnConfirmPurchaseClicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>