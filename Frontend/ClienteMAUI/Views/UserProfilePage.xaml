<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClienteMAUI.Views.UserProfilePage"
             Title="Mi perfil">
    <ScrollView>
        <VerticalStackLayout>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Text="Aqui podras ver tu perfil"
                       Grid.Row="0"
                       FontSize="22"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"/>
                <!--Rows for buttons and templates-->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackLayout Grid.Row="0" Orientation="Horizontal"
                                 VerticalOptions="Center" HorizontalOptions="Center"
                                 Margin="15, 10">
                        <Button x:Name="BtnProducts"
                                Text="Mis productos"
                                Clicked="BtnLoadUserProducts"
                                BackgroundColor="LightGray"
                                TextColor="Black"
                                CornerRadius="12"
                                Margin="0, 5, 15, 5"/>
                        <Button x:Name="BtnAuctions"
                                Text="Mis subastas"
                                Clicked="BtnLoadUserAuctions"
                                BackgroundColor="LightGray"
                                TextColor="Black"
                                CornerRadius="12"
                                Margin="0, 5, 15, 5"/>
                        <Button x:Name="BtnStatistics"
                                Text="Estadisticas"
                                Clicked="BtnNavigateToStatsPage"
                                BackgroundColor="LightGray"
                                TextColor="Black"
                                CornerRadius="12"
                                Margin="0, 5, 5, 5"/>
                    </StackLayout>

                    <Border Background="DimGray" Grid.Row="1">
                        <StackLayout Orientation="Vertical" VerticalOptions="Center"
                                 HorizontalOptions="Center" Margin="15, 0">
                            <Picker x:Name="AuctionStatusPicker" Title="Filtros"
                                    SelectedIndexChanged="OnAuctionStatusChanged">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Todos</x:String>
                                        <x:String>Activos</x:String>
                                        <x:String>Cancelados</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                            <!--Load user products/auctions-->
                            <StackLayout Orientation="Vertical" Margin="15, 0">
                                <!--Product-->
                                <CollectionView x:Name="ItemsCollection"
                                        ItemsLayout="VerticalGrid, 2"
                                        SelectionMode="None"
                                            IsVisible="True">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Stroke="LightGray" StrokeThickness="1"
                                                Padding="10" Margin="5" StrokeShape="RoundRectangle 10">
                                                <VerticalStackLayout>
                                                    <Image Source="{Binding ImageSource}"
                                                       HeightRequest="100" Aspect="AspectFill"/>
                                                    <Label Text="{Binding Nombre}" FontAttributes="Bold"
                                                       FontSize="16"/>
                                                    <Label Text="{Binding Precio, StringFormat='${0:F2}'}"
                                                       FontSize="14"/>
                                                    <Label Text="{Binding CantidadVendidos, StringFormat='Vendidos: {0}'}"
                                                       FontSize="12"/>
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                                
                                <!--Auction-->
                                <CollectionView x:Name="AuctionsCollection"
                                                ItemsLayout="VerticalGrid, 2"
                                                IsVisible="False">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Stroke="LightGray" StrokeThickness="1" Padding="10" Margin="5" StrokeShape="RoundRectangle 10">
                                                <VerticalStackLayout>
                                                    <Image Source="{Binding ImageSource}" HeightRequest="100"
                                                           Aspect="AspectFill"/>
                                                    <Label Text="{Binding ProductName}" FontAttributes="Bold"
                                                           FontSize="16" />
                                                    <Label Text="{Binding FirstPriceText}" FontSize="14" />
                                                    <Label Text="{Binding LastPriceText}" FontSize="14" />
                                                    <Label Text="{Binding BidText}" FontSize="14" />
                                                    <Label Text="{Binding EndDateFormatted}" FontSize="12" />
                                                    <Button Text="Finalizar" BackgroundColor="DarkRed" 
                                                            TextColor="White" Clicked="BtnEndAuction"
                                                            CommandParameter="{Binding Id}"/>
                                                    <Button Text="Ver pujas" BackgroundColor="DeepSkyBlue"
                                                            TextColor="Black" Clicked="BtnAuctionDetails"
                                                            CommandParameter="{Binding Id}"/>
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </StackLayout>
                        </StackLayout>
                    </Border>
                </Grid>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>