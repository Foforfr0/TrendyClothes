{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "authservice",
        "Match": { "Path": "/api/User/{**catch-all}" }
      },
      "profile": {
        "ClusterId": "profileservice",
        "Match": { "Path": "/api/User/ViewProfile/{**catch-all}" }
      },
      "account": {
        "ClusterId": "accountservice",
        "Match": { "Path": "/api/User/Registration/{**catch-all}" }
      },
      "account-validation": {
        "ClusterId": "accountservice",
        "Match": { "Path": "/api/User/ValidateUserData/{**catch-all}" }
      },
      "account-delete": {
        "ClusterId": "accountservice",
        "Match": { "Path": "/api/User/DeleteAccount/{**catch-all}" }
      },
      "product-image": {
        "ClusterId": "productservice",
        "Match": { "Path": "/api/Product/Image/{**catch-all}" }
      },
      "product-tags": {
        "ClusterId": "productservice",
        "Match": { "Path": "/api/Product/Tags/{**catch-all}" }
      },
      "product-seller-list": {
        "ClusterId": "productsellerservice",
        "Match": { "Path": "/api/MyProducts/{**catch-all}" }
      },
      "product-seller-create": {
        "ClusterId": "productsellerservice",
        "Match": { "Path": "/api/MyProduct/{**catch-all}" }
      },
      "product-seller-edit": {
        "ClusterId": "productsellerservice",
        "Match": { "Path": "/api/MyProduct/Edit/{**catch-all}" }
      },
      "product-seller-delete": {
        "ClusterId": "productsellerservice",
        "Match": { "Path": "/api/MyProduct/Delete/{**catch-all}" }
      },
      "auction-image": {
        "ClusterId": "auctionauctioneerservice",
        "Match": { "Path": "/api/Auction/Image/{**catch-all}" }
      },
      "auction-create": {
        "ClusterId": "auctionauctioneerservice",
        "Match": { "Path": "/api/Auction/Auctioneer/CreateAuction/{**catch-all}" }
      },
      "auction-consult": {
        "ClusterId": "auctionauctioneerservice",
        "Match": { "Path": "/api/Auction/Auctioneer/ConsultMyAuctions/{**catch-all}" }
      },
      "auction-update": {
        "ClusterId": "auctionauctioneerservice",
        "Match": { "Path": "/api/Auction/Auctioneer/UpdateAuction/{**catch-all}" }
      },
      "participant-auctions": {
        "ClusterId": "auctionparticipantservice",
        "Match": { "Path": "/api/Auction/Participant/ConsultAuction/{**catch-all}" }
      },
      "participant-bids": {
        "ClusterId": "auctionparticipantservice",
        "Match": { "Path": "/api/Auction/Participant/CreateBid/{**catch-all}" }
      }
    },
    "Clusters": {
      "authservice": {
        "Destinations": {
          "auth": { "Address": "http://authservice:80/" }
        }
      },
      "profileservice": {
        "Destinations": {
          "profile": { "Address": "http://profileservice:80/" }
        }
      },
      "accountservice": {
        "Destinations": {
          "account": { "Address": "http://accountservice:80/" }
        }
      },
      "productservice": {
        "Destinations": {
          "product": { "Address": "http://productservice:80/" }
        }
      },
      "productbuyerservice": {
        "Destinations": {
          "productbuyer": { "Address": "http://productbuyerservice:80/" }
        }
      },
      "productsellerservice": {
        "Destinations": {
          "productseller": { "Address": "http://productsellerservice:80/" }
        }
      },
      "auctionauctioneerservice": {
        "Destinations": {
          "auctioneer": { "Address": "http://auctionauctioneerservice:80/" }
        }
      },
      "auctionparticipantservice": {
        "Destinations": {
          "participant": { "Address": "http://auctionparticipantservice:80/" }
        }
      }
    }
  }
}
